---
import { languageOrder, type Lang } from "../data/museumEntries";

const languageMeta: Record<Lang, { label: string; placeholder: string }> = {
  en: { label: "EN", placeholder: "English name" },
  fr: { label: "FR", placeholder: "Nom en français" },
  ru: { label: "RU", placeholder: "Имя на русском" },
};
---

<section class="relative">
  <div id="stage" class="sticky top-0 z-1 flex h-screen items-center justify-center gap-4 px-6 py-16 sm:gap-8">
    <button
      id="nav-prev"
      class="grid h-12 w-12 hover:cursor-pointer flex-none place-items-center rounded-full text-white/85 transition-opacity hover:opacity-60"
      aria-label="Previous"
    >
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <div class="relative w-[min(90vw,460px)]">
      <article
        id="card"
        class="relative rounded-[1.75rem] border border-white/10 px-8 pb-12 pt-11 text-center transition-all duration-300 ease-out backdrop-blur-sm"
      >
        <button
          id="add-btn"
          class="absolute hover:cursor-pointer left-[-1.1rem] top-[-1.1rem] grid h-11 w-11 place-items-center rounded-full bg-white/15 text-white shadow-[0_8px_20px_rgba(0,0,0,0.35)] backdrop-blur transition-colors hover:bg-white/25"
          aria-label="Add muse"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14" stroke-linecap="round" />
          </svg>
        </button>

        <ul id="card-lines" class="flex flex-col gap-3.5 font-serif"></ul>

        <p id="lang-badge" class="mt-7 text-xs uppercase tracking-[0.25em] text-white/40">en</p>
      </article>
    </div>

    <button
      id="nav-next"
      class="grid h-12 w-12 hover:cursor-pointer flex-none place-items-center rounded-full text-white/85 transition-opacity hover:opacity-60"
      aria-label="Next"
    >
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  <!-- Scroll-driven language sections: default en, then fr, then ru. -->
  <div class="lang-marker h-screen" data-lang="fr"></div>
  <div class="lang-marker h-screen" data-lang="ru"></div>
</section>

<dialog
  id="add-modal"
  class="m-auto w-[min(92vw,440px)] max-h-[85vh] overflow-y-auto rounded-3xl border border-white/10 bg-[#2f2f2e] p-7 text-white shadow-[0_30px_80px_rgba(0,0,0,0.55)] backdrop:bg-black/65 backdrop:backdrop-blur-sm"
>
  <form id="add-form" class="flex flex-col gap-5">
    <div class="flex items-center justify-between">
      <h2 class="font-serif text-xl font-semibold">Add a muse</h2>
      <button
        type="button"
        id="modal-close"
        class="grid h-8 w-8 place-items-center rounded-full text-white/70 transition-colors hover:bg-white/10"
        aria-label="Close"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <p class="text-sm text-white/50">Name it in one or more languages, and mark which one is the main.</p>

    <div class="flex flex-col gap-3">
      {
        languageOrder.map((code, i) => (
          <label class="flex items-center gap-3">
            <input
              type="radio"
              name="main-lang"
              value={code}
              checked={i === 0}
              class="h-4 w-4 accent-white"
              aria-label={`Use ${languageMeta[code].label} as the main language`}
            />
            <span class="w-7 shrink-0 text-xs uppercase tracking-wide text-white/50">{languageMeta[code].label}</span>
            <input
              type="text"
              name={`lang-${code}`}
              placeholder={languageMeta[code].placeholder}
              class="flex-1 rounded-lg border border-white/15 bg-white/5 px-3 py-2 text-sm text-white placeholder:text-white/30 focus:border-white/40 focus:outline-none"
            />
          </label>
        ))
      }
    </div>

    <div class="flex justify-end gap-3 pt-1">
      <button
        type="button"
        id="modal-cancel"
        class="rounded-full px-4 py-2 text-sm text-white/60 transition-colors hover:bg-white/10"
      >
        Cancel
      </button>
      <button
        type="submit"
        class="rounded-full bg-white px-5 py-2 text-sm font-semibold text-bg-bottom transition-colors hover:bg-white/85"
      >
        Add
      </button>
    </div>
  </form>
</dialog>

<script>
  import { languageOrder, type Lang } from "../data/museumEntries";

  const API = import.meta.env.PUBLIC_API_URL as string;

  const card = document.getElementById("card") as HTMLElement;
  const linesEl = document.getElementById("card-lines") as HTMLElement;
  const badgeEl = document.getElementById("lang-badge") as HTMLElement;
  const prevBtn = document.getElementById("nav-prev") as HTMLButtonElement;
  const nextBtn = document.getElementById("nav-next") as HTMLButtonElement;
  const addBtn = document.getElementById("add-btn") as HTMLButtonElement;
  const modal = document.getElementById("add-modal") as HTMLDialogElement;
  const modalClose = document.getElementById("modal-close") as HTMLButtonElement;
  const modalCancel = document.getElementById("modal-cancel") as HTMLButtonElement;
  const addForm = document.getElementById("add-form") as HTMLFormElement;
  const markers = Array.from(document.querySelectorAll<HTMLElement>(".lang-marker"));

  type MuseEntry = { id: number; lines: Record<Lang, string[]>; order: number };

  let museumEntries: MuseEntry[] = [];
  let entryIndex = 0;
  let lang: Lang = languageOrder[0];

  async function loadMuses() {
    const res = await fetch(`${API}/api/muses`, { cache: 'no-store' });
    museumEntries = await res.json();
    if (museumEntries.length > 0) renderContent();
  }

  function renderContent() {
    const entry = museumEntries[entryIndex];
    const lines = entry.lines[lang];

    badgeEl.textContent = lang;

    linesEl.innerHTML = "";
    lines.forEach((line, i) => {
      const li = document.createElement("li");
      li.textContent = line;
      li.className = ["text-base sm:text-lg", i === 0 && "font-semibold", i === lines.length - 1 && "text-white"]
        .filter(Boolean)
        .join(" ");
      linesEl.appendChild(li);
    });
  }

  function swapEntry(direction: 1 | -1) {
    card.style.transform = `translateX(${direction * -24}px)`;
    card.style.opacity = "0";

    window.setTimeout(() => {
      entryIndex = (entryIndex + direction + museumEntries.length) % museumEntries.length;
      renderContent();

      card.style.transition = "none";
      card.style.transform = `translateX(${direction * 24}px)`;

      requestAnimationFrame(() => {
        card.style.transition = "";
        card.style.transform = "";
        card.style.opacity = "1";
      });
    }, 260);
  }

  function setLanguage(next: Lang) {
    if (next === lang) return;
    lang = next;

    card.style.opacity = "0.35";
    window.setTimeout(() => {
      renderContent();
      card.style.opacity = "1";
    }, 150);
  }

  prevBtn.addEventListener("click", () => swapEntry(-1));
  nextBtn.addEventListener("click", () => swapEntry(1));

  addBtn.addEventListener("click", () => modal.showModal());
  modalClose.addEventListener("click", () => modal.close());
  modalCancel.addEventListener("click", () => modal.close());
  modal.addEventListener("click", (e) => {
    if (e.target === modal) modal.close();
  });
  modal.addEventListener("close", () => {
    addForm.reset();
    addForm.querySelectorAll<HTMLInputElement>("input[type=text]").forEach((input) => {
      input.setCustomValidity("");
    });
  });

  addForm.addEventListener("submit", async (e) => {
    e.preventDefault();

    const data = new FormData(addForm);
    const mainLang = data.get("main-lang") as Lang;
    const values: Record<Lang, string> = {
      en: (data.get("lang-en") as string).trim(),
      fr: (data.get("lang-fr") as string).trim(),
      ru: (data.get("lang-ru") as string).trim(),
    };

    const mainInput = addForm.querySelector<HTMLInputElement>(`input[name="lang-${mainLang}"]`)!;
    if (!values[mainLang]) {
      mainInput.setCustomValidity("Fill in the main language name.");
      mainInput.reportValidity();
      return;
    }
    mainInput.setCustomValidity("");

    const res = await fetch(`${API}/api/muses`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        lines: {
          en: [values.en || values[mainLang]],
          fr: [values.fr || values[mainLang]],
          ru: [values.ru || values[mainLang]],
        },
        order: museumEntries.length + 1,
      }),
    });

    if (!res.ok) { modal.close(); return; }

    const newMuse: MuseEntry = await res.json();
    museumEntries.push(newMuse);
    entryIndex = museumEntries.length - 1;
    renderContent();
    modal.close();
  });

  let ticking = false;
  function updateLanguageFromScroll() {
    ticking = false;
    // Count how many markers have scrolled past the viewport's center —
    // more robust than scrollY/innerHeight math, which can miss the last
    // section by a fraction of a pixel right at the bottom of the page.
    const viewportCenter = window.innerHeight / 2;
    let sectionIndex = 0;
    for (const marker of markers) {
      if (marker.getBoundingClientRect().top <= viewportCenter) {
        sectionIndex += 1;
      }
    }
    setLanguage(languageOrder[Math.min(sectionIndex, languageOrder.length - 1)]);
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateLanguageFromScroll);
      }
    },
    { passive: true }
  );

  updateLanguageFromScroll();
  loadMuses();
</script>
